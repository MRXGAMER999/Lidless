              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%lld nits"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld: %@" : {
      "comment" : "VoiceOver label of a numbered Safety net item in Settings: its place in the list of three, then its title, e.g. “2 of 3: Ask before keeping it off”",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld of %2$lld: %3$@"
          }
        }
      }
    },
    "**Boost on · ≈ %@ nits.** Uses more battery and heat. Steps back by itself if your Mac gets hot." : {
      "comment" : "Boost callout in the popover; the variable is the estimated brightness in nits"
    },
    "A small, open-source menu bar app for your MacBook's screen." : {
      "comment" : "Onboarding step 1 introduction"
    },
    "About %lld nits max, up to %lld%% brightness" : {
      "comment" : "VoiceOver label of the Boost ceiling headline in Settings › Brightness. The first variable is the ceiling in nits (e.g. 1000), the second the brightest Boost gets as a percentage of normal maximum (e.g. 167).",
