{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ brightness" : {
      "comment" : "VoiceOver label of an external display's brightness slider; the variable is the display name"
    },
    "%@ · Dimmed by Lidless" : {
      "comment" : "External display row subtitle when the monitor can't change its own brightness, so Lidless darkens the picture with an overlay; the variable is a resolution such as 5K or 1080p. Keep it short: it shares one line with the slider."
    },
    "%@ · Extended" : {
      "comment" : "External display row subtitle; the variable is a resolution such as 5K or 1080p"
    },
    "%@ · Main display" : {
      "comment" : "External display row subtitle; the variable is a resolution such as 5K or 1080p"
    },
    "%@ · Mirrored" : {
      "comment" : "External display row subtitle; the variable is a resolution such as 5K or 1080p"
    },
    "%@, Boost" : {
      "comment" : "VoiceOver reading of the built-in display card's brightness percentage while boosted, e.g. “160%, Boost”. The variable is the brightness in percent."
    },
    "%@, Boost, about %lld nits" : {
      "comment" : "VoiceOver value of the built-in brightness slider while boosted, e.g. “160%, Boost, about 800 nits”. The first variable is the brightness in percent (above 100%), the second the estimated brightness in nits. “Boost” is the feature that makes the screen brighter than normal.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, Boost, about %2$lld nits"
          }
        }
      }
    },
    "%@, about %lld nits" : {
      "comment" : "VoiceOver value of the built-in brightness slider, e.g. “70%, about 350 nits”. The first variable is the brightness in percent, the second the estimated brightness in nits.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, about %2$lld nits"
          }
        }
      }
    },
    "%lld displays" : {
      "comment" : "Popover status line segment: number of lit displays",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%lld display"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "%lld displays"
                }
              }
            }
          }
        }
      }
    },
    "%lld nits" : {
      "comment" : "VoiceOver value of the Boost ceiling slider; the variable is the ceiling in nits, e.g. \"1000 nits\"",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
